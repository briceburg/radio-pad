# Copy this file to .env and fill in values as needed.
# .env is gitignored — never commit credentials or local overrides.

# Port configuration.
# Ports default to ephemeral (0) to avoid conflicts.
# The web app defaults to 5173 so the Google OAuth redirect URI stays stable.
RADIOPAD_REGISTRY_PORT=0
RADIOPAD_REMOTE_CONTROL_PORT=5173
RADIOPAD_SWITCHBOARD_PORT=0

# Google OAuth client ID — enables sign-in in the remote control and write auth in the registry.
# Create a Web application OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin: http://localhost:5173
# Authorized redirect URI:      http://localhost:5173/
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
