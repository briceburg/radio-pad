# Copy this file to .env and fill in values as needed.
# .env is gitignored — never commit credentials or local overrides.

# Port configuration.
# Ports default to ephemeral (0) to avoid conflicts.
# The web app defaults to 5173 so the Google OAuth redirect URI stays stable.
RADIOPAD_REGISTRY_PORT=0
RADIOPAD_REMOTE_CONTROL_PORT=5173
RADIOPAD_SWITCHBOARD_PORT=0

# Google OAuth client ID — see the auth setup sections in the root, registry,
# and remote-control READMEs for the browser origin/redirect and registry write auth.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
