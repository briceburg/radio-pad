# Copy this file to .env and fill in values as needed.
# .env is gitignored — never commit credentials or local overrides.

# Port configuration.
# Ports default to ephemeral (0) to avoid conflicts.
# The web app defaults to 5173 so the Google OAuth redirect URI stays stable.
RADIOPAD_REGISTRY_PORT=0
RADIOPAD_REMOTE_CONTROL_PORT=5173
RADIOPAD_SWITCHBOARD_PORT=0

# Set bin/dev audio, Macropad, device, and socket options in the shell.
# This file is read by Compose only; see README.md#configuration-and-host-integration.

# Optional player output override; use null for headless playback when bin/dev audio routing is off.
# RADIOPAD_AUDIO_OUTPUT=null

# Google Web OAuth client ID shared by the remote-control build and registry token validation.
# Setup: README.md#google-sign-in
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
