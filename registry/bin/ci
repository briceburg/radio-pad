#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-tmp/.venv}"
# Dulwich resolves a fallback username even when commit identities are explicit.
export USER="${USER:-radiopad}"

uv run mypy src/ tests/
uv run ruff format --check src/ tests/
uv run ruff check src/ tests/
uv run pytest
