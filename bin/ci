#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

if [[ $# -gt 0 ]]; then
  if [[ "$1" != integration ]]; then
    echo "usage: bin/ci [integration [COMPOSE_FILE ...]]" >&2
    exit 2
  fi
  shift
  exec tests/integration/bin/ci "$@"
fi

bash -n bin/*
npm run lint
exec node_modules/.bin/concurrently \
  --kill-others-on-fail \
  --prefix command \
  --prefix-length 30 \
  "remote-control/bin/ci" \
  "player/bin/ci" \
  "registry/bin/ci" \
  "macropad-control/bin/ci"
