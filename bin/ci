#!/usr/bin/env sh
set -eu

export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-radiopad-ci}"
export COMPOSE_FILE="${1:-${COMPOSE_FILE:-compose.yaml}}"

cd "$(dirname "$0")/.."
trap 'docker compose down --volumes --remove-orphans' EXIT

echo "Running integration tests for $COMPOSE_PROJECT_NAME ($COMPOSE_FILE) ..." >&2

if ! docker compose run --rm --build integration-tests; then
  docker compose logs
  exit 1
fi
