#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mode="${RADIOPAD_MACROPAD:-auto}"
audio_mode="${RADIOPAD_AUDIO:-auto}"
compose_files=(-f "$root/compose.yaml")

die() {
  echo "[error] $*" >&2
  exit 1
}

set_device_gid() {
  local var_name="$1"
  local device="$2"
  local gid

  if [ -n "${!var_name:-}" ] || [ -z "$device" ]; then
    return 0
  fi

  gid="$(stat -c "%g" "$device" 2>/dev/null || true)"
  if [ -n "$gid" ]; then
    export "$var_name=$gid"
  fi
}

use_audio() {
  local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  local pulse_socket="${RADIOPAD_PULSE_SOCKET:-}"
  local pipewire_socket="${RADIOPAD_PIPEWIRE_SOCKET:-}"

  if [ -z "$pulse_socket" ]; then
    pulse_socket="$runtime_dir/pulse/native"
  fi
  if [ -z "$pipewire_socket" ]; then
    pipewire_socket="$runtime_dir/pipewire-0"
  fi

  export RADIOPAD_HOST_UID="${RADIOPAD_HOST_UID:-$(id -u)}"
  export RADIOPAD_HOST_GID="${RADIOPAD_HOST_GID:-$(id -g)}"

  if [ -S "$pulse_socket" ]; then
    export RADIOPAD_AUDIO_OUTPUT="pulse"
    export RADIOPAD_AUDIO_SOCKET="$pulse_socket"
    export RADIOPAD_AUDIO_SOCKET_TARGET="/tmp/radio-pad-audio/pulse-native"
    export RADIOPAD_PULSE_SERVER="unix:$RADIOPAD_AUDIO_SOCKET_TARGET"
    echo "[info] using Pulse/PipeWire Pulse socket: $pulse_socket" >&2
  elif [ -S "$pipewire_socket" ]; then
    export RADIOPAD_AUDIO_OUTPUT="pipewire"
    export RADIOPAD_AUDIO_SOCKET="$pipewire_socket"
    export RADIOPAD_AUDIO_SOCKET_TARGET="/tmp/radio-pad-audio/pipewire-0"
    export RADIOPAD_PULSE_SERVER=""
    echo "[info] using PipeWire socket: $pipewire_socket" >&2
  else
    die "Pulse/PipeWire audio socket not found at $pulse_socket or $pipewire_socket; set RADIOPAD_AUDIO=off to start without container audio"
  fi

  compose_files+=(-f "$root/compose.audio.yaml")
}

configure_audio() {
  case "$audio_mode" in
    auto)
      use_audio
      ;;
    off)
      echo "[info] leaving player audio routing unmanaged; RADIOPAD_AUDIO_OUTPUT will pass through unchanged" >&2
      ;;
    *)
      usage
      die "invalid RADIOPAD_AUDIO mode: $audio_mode"
      ;;
  esac
}

usage() {
  cat >&2 <<'EOF'
usage: bin/dev [docker compose args...]

Audio modes:
  RADIOPAD_AUDIO=auto   use the host Pulse/PipeWire audio socket (default)
  RADIOPAD_AUDIO=off    leave audio routing unmanaged

Set RADIOPAD_PULSE_SOCKET=/run/user/.../pulse/native to choose a Pulse socket.
Set RADIOPAD_PIPEWIRE_SOCKET=/run/user/.../pipewire-0 to choose a PipeWire socket.

Macropad modes:
  RADIOPAD_MACROPAD=auto      use the macropad overlay when one data port is found (default)
  RADIOPAD_MACROPAD=required  fail if no macropad data port is available
  RADIOPAD_MACROPAD=off       never use the macropad overlay

Set RADIOPAD_MACROPAD_DEVICE=/dev/ttyACM... to choose a specific CDC2 data port.
EOF
}

macropad_device() {
  if [ -n "${RADIOPAD_MACROPAD_DEVICE:-}" ]; then
    echo "$RADIOPAD_MACROPAD_DEVICE"
    return 0
  fi

  "$root/macropad-control/bin/data-port"
}

use_macropad() {
  export RADIOPAD_MACROPAD_DEVICE="$1"
  set_device_gid RADIOPAD_MACROPAD_GID "$RADIOPAD_MACROPAD_DEVICE"
  if [ -z "${RADIOPAD_MACROPAD_GID:-}" ]; then
    die "could not determine macropad device group id; set RADIOPAD_MACROPAD_GID"
  fi

  compose_files+=(-f "$root/compose.macropad.yaml")
  echo "[info] using macropad data port: $RADIOPAD_MACROPAD_DEVICE with group $RADIOPAD_MACROPAD_GID" >&2
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
  usage
  exit 0
fi

configure_audio

case "$mode" in
  auto|required)
    if device="$(macropad_device 2>&1)"; then
      use_macropad "$device"
    elif [ "$mode" = "auto" ] && [[ "$device" == *"not found"* ]]; then
      echo "[info] no macropad data port found; starting without local macropad" >&2
    else
      die "$device"
    fi
    ;;
  off)
    ;;
  *)
    usage
    die "invalid RADIOPAD_MACROPAD mode: $mode"
    ;;
esac

exec docker compose "${compose_files[@]}" "$@"
