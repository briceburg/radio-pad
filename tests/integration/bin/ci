#!/usr/bin/env sh
set -eu

project_root="$(cd "$(dirname "$0")/.." && pwd)"
repo_root="$(cd "$project_root/../.." && pwd)"

cd "$project_root"
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-tmp/.venv}"

sh -n bin/*

uv run --locked mypy .
uv run --locked ruff format --check .
uv run --locked ruff check .
uv run --locked pytest --collect-only -q

if [ "$#" -eq 0 ]; then
  set -- compose.yaml compose.split.yaml "compose.yaml:compose.auth.yaml" compose.prod-smoke.yaml
fi

export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-radiopad-ci}"
export RADIOPAD_REGISTRY_PORT="${RADIOPAD_REGISTRY_PORT:-0}"
export RADIOPAD_SWITCHBOARD_PORT="${RADIOPAD_SWITCHBOARD_PORT:-0}"
export RADIOPAD_AUDIO_DEVICE="${RADIOPAD_AUDIO_DEVICE:-}"
export RADIOPAD_AUDIO_OUTPUT="${RADIOPAD_AUDIO_OUTPUT:-null}"
export RADIOPAD_REMOTE_CONTROL_PORT="${RADIOPAD_REMOTE_CONTROL_PORT:-0}"

# Keep integration CI auth-disabled even when a local .env enables Google OIDC.
export GOOGLE_CLIENT_ID=""

cd "$repo_root"

for compose_file in "$@"; do
  (
    export COMPOSE_FILE="$compose_file"
    trap 'docker compose down --volumes --remove-orphans' EXIT

    echo "Running integration tests for $COMPOSE_PROJECT_NAME ($COMPOSE_FILE) ..." >&2
    if ! docker compose run --rm --build integration-tests; then
      docker compose logs
      exit 1
    fi
  )
done
