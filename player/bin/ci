#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."
. ./lib/uv.sh

for script in bin/* lib/*.sh; do
  bash -n "$script"
done
uv run --locked tests/bin/check-url-resolver
export ANSIBLE_COLLECTIONS_PATH="$PWD/tmp/ansible/collections"
uvx --from ansible-core==2.21.4 ansible-galaxy collection install \
  --requirements-file deploy/raspberry-pi/requirements.yml \
  --collections-path "$ANSIBLE_COLLECTIONS_PATH"
ANSIBLE_CONFIG=deploy/raspberry-pi/ansible.cfg \
  uvx --from ansible-core==2.21.4 ansible-playbook \
  --syntax-check --inventory localhost, deploy/raspberry-pi/playbook.yml
uv run --locked mypy src/ tests/
uv run --locked ruff format --check src/ tests/
uv run --locked ruff check src/ tests/
uv run --locked pytest
