#!/usr/bin/env bash
set -euo pipefail

source_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../src" && pwd)"
target="/mnt/CIRCUITPY"
device="$(readlink -f /dev/disk/by-label/CIRCUITPY 2>/dev/null || true)"
mounted_source="$(findmnt -nro SOURCE --mountpoint "$target" 2>/dev/null || true)"
mounted_device="$(readlink -f "$mounted_source" 2>/dev/null || true)"
mount_options=",$(findmnt -nro OPTIONS --mountpoint "$target" 2>/dev/null || true),"

if [ -z "$device" ]; then
  echo "CIRCUITPY storage device not found; is the macropad attached?" >&2
  exit 1
fi

if [ -z "$mounted_source" ]; then
  echo "$target is not mounted; run macropad-control/bin/mount" >&2
  exit 1
fi

if [ "$mounted_device" != "$device" ]; then
  echo "$target is mounted from ${mounted_device:-$mounted_source}, but CIRCUITPY is $device; run macropad-control/bin/mount" >&2
  exit 1
fi

if [[ "$mount_options" != *,rw,* ]] || [[ "$mount_options" != *,sync,* ]]; then
  echo "$target is not mounted read/write synchronously; run macropad-control/bin/mount" >&2
  exit 1
fi

echo "[info] syncing RadioPad code; synchronized flash writes may take about a minute"
staging="$(mktemp -d "$target/.radio-pad-sync.XXXXXX")"
trap 'rm -rf -- "$staging" 2>/dev/null || true' EXIT

tar -C "$source_dir" --exclude=__pycache__ -cf - boot.py lib main.py |
  tar -C "$staging" -xf -
sync -f "$staging"
diff -q "$source_dir/boot.py" "$staging/boot.py"
diff -qr --exclude=__pycache__ "$source_dir/lib" "$staging/lib"
diff -q "$source_dir/main.py" "$staging/main.py"

rm -rf "$target"/{boot.py,code.py,lib,main.py}
mv "$staging"/{boot.py,lib,main.py} "$target/"
sync -f "$target"

diff -q "$source_dir/boot.py" "$target/boot.py"
diff -qr --exclude=__pycache__ "$source_dir/lib" "$target/lib"
diff -q "$source_dir/main.py" "$target/main.py"

echo "[ok] synced and verified RadioPad code at $target"
if [ "${RADIOPAD_PROVISION:-0}" != "1" ]; then
  echo "[next] run bin/mount --unmount, reset the Macropad, then rerun bin/mount and bin/doctor"
fi
