#!/usr/bin/env bash
set -euo pipefail

source_dir="$(git rev-parse --show-toplevel)/macropad-control/src"
target="/mnt/CIRCUITPY"
device="$(readlink -f /dev/disk/by-label/CIRCUITPY 2>/dev/null || true)"
mounted_source="$(findmnt -nro SOURCE --mountpoint "$target" 2>/dev/null || true)"
mounted_device="$(readlink -f "$mounted_source" 2>/dev/null || true)"
mount_options=",$(findmnt -nro OPTIONS --mountpoint "$target" 2>/dev/null || true),"

if [ -z "$device" ]; then
  echo "CIRCUITPY storage device not found; is the macropad attached?" >&2
  exit 1
fi

if [ -z "$mounted_source" ]; then
  echo "$target is not mounted; run macropad-control/bin/mount" >&2
  exit 1
fi

if [ "$mounted_device" != "$device" ]; then
  echo "$target is mounted from ${mounted_device:-$mounted_source}, but CIRCUITPY is $device; run macropad-control/bin/mount" >&2
  exit 1
fi

if [[ "$mount_options" != *,rw,* ]]; then
  echo "$target is mounted read-only; run macropad-control/bin/mount" >&2
  exit 1
fi

rm -rf "$target"/{boot.py,lib,main.py}
cp -R "$source_dir"/{boot.py,lib} "$target/"
cp -R "$source_dir/main.py" "$target/main.py"
sync

diff -q "$source_dir/boot.py" "$target/boot.py"
diff -qr "$source_dir/lib" "$target/lib"
diff -q "$source_dir/main.py" "$target/main.py"

echo "[ok] synced and verified firmware at $target"
