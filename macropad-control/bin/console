#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dev="$("$script_dir/console-port")"

if ! command -v screen >/dev/null; then
  echo "screen not found; install screen or connect manually to $dev at 115200 baud" >&2
  exit 1
fi

echo "[info] attaching to CircuitPython console at $dev" >&2
echo "[info] screen detach: Ctrl-A d; quit: Ctrl-A k, then y" >&2
screen "$dev" 115200
