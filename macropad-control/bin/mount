#!/usr/bin/env bash
set -euo pipefail

target="/mnt/CIRCUITPY"
disk="$(readlink -f /dev/disk/by-label/CIRCUITPY 2>/dev/null || true)"

if [ -z "$disk" ]; then
  echo "CIRCUITPY device not found; is the macropad attached?" >&2
  exit 1
fi

mounted_source="$(findmnt -nro SOURCE --mountpoint "$target" 2>/dev/null || true)"
mounted_disk="$(readlink -f "$mounted_source" 2>/dev/null || true)"
mount_options=",$(findmnt -nro OPTIONS --mountpoint "$target" 2>/dev/null || true),"

if [ "$mounted_disk" = "$disk" ] && [[ "$mount_options" == *,rw,* ]] && [[ "$mount_options" == *,sync,* ]]; then
  echo "[ok] $disk is already mounted read/write synchronously at $target"
else
  if mountpoint -q "$target"; then
    echo "[info] replacing stale, read-only, or asynchronous mount at $target"
    sudo umount "$target"
  fi

  [ -d "$target" ] || sudo mkdir -p "$target"
  sudo mount "$disk" "$target" -o "uid=$(id -u),rw,sync"
fi

probe="$(mktemp "$target/.radio-pad-write-test.XXXXXX")"
trap 'rm -f -- "$probe" 2>/dev/null || true' EXIT

printf 'radio-pad storage write test\n' >"$probe"
sync -f "$probe"
rm -f -- "$probe"

echo "[ok] $disk accepts synchronized writes at $target"
