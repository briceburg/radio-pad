#!/usr/bin/env bash
set -euo pipefail

target="/mnt/CIRCUITPY"
disk="$(readlink -f /dev/disk/by-label/CIRCUITPY 2>/dev/null || true)"

if [ -z "$disk" ]; then
  echo "CIRCUITPY device not found; is the macropad attached?" >&2
  exit 1
fi

mounted_source="$(findmnt -nro SOURCE --mountpoint "$target" 2>/dev/null || true)"
mounted_disk="$(readlink -f "$mounted_source" 2>/dev/null || true)"
mount_options=",$(findmnt -nro OPTIONS --mountpoint "$target" 2>/dev/null || true),"

if [ "$mounted_disk" = "$disk" ] && [[ "$mount_options" == *,rw,* ]]; then
  echo "[ok] $disk is already mounted read/write at $target"
  exit 0
fi

if mountpoint -q "$target"; then
  echo "[info] replacing stale or read-only mount"
  sudo umount "$target"
fi

[ -d "$target" ] || sudo mkdir -p "$target"
sudo mount "$disk" "$target" -o "uid=$(id -u),rw"
echo "[ok] mounted $disk read/write at $target"
